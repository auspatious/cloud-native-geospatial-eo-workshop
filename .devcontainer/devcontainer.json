{
  "name": "Cloud Native Geo for EO",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/astral-sh/uv/devcontainer-feature:1": {}
  },
  "updateContentCommand": "uv sync",
  "postCreateCommand": ".venv/bin/python -m ipykernel install --user --name cloud-native-geo-eo --display-name 'Cloud Native Geo for EO'",
  "forwardPorts": [8888, 8787],
  "portsAttributes": {
    "8888": { "label": "Jupyter", "onAutoForward": "openBrowser" },
    "8787": { "label": "Dask Dashboard" }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff"
      ]
    }
  },
  "remoteUser": "vscode"
}
