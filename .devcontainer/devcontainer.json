{
  "name": "Cloud Native Geo for EO",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "onCreateCommand": "pip install --user uv",
  "postCreateCommand": "uv sync && .venv/bin/python -m ipykernel install --user --name cloud-native-geo-eo --display-name 'Cloud Native Geo for EO'",
"customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff"
      ]
    }
  },
  "remoteUser": "vscode"
}
